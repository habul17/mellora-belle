// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Size {
  S
  M
  L
  XL
  XXL
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String
  basePrice      Int
  compareAtPrice Int?
  weight         Int
  images         String[]
  isActive       Boolean
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  variants       Variant[]
}

model Variant {
  id            String      @id @default(cuid())
  size          Size
  color         String
  sku           String      @unique
  stockQuantity Int
  priceOverride Int?
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  cartItems     CartItem[]
  orderItems    OrderItem[]
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  passwordHash  String
  role          Role                 @default(CUSTOMER)
  createdAt     DateTime             @default(now())
  resetTokens   PasswordResetToken[]
  refreshTokens RefreshToken[]
  totpSecret    String?
  // A new authenticator being set up. It only replaces totpSecret once a
  // code from it has been typed in, so a bad scan can't lock the admin out.
  totpPendingSecret String?
  cart          Cart?
  orders        Order[]
  auditLogs     AuditLog[]
}

// Who changed what in the admin, and when: stock counts, order steps,
// cancellations, refunds, 2FA. Written after each change succeeds; nothing
// reads it back in the app, it's there to answer "what happened?" later.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// A long-lived login, kept in an httpOnly cookie the page's JavaScript can't
// read. Only its hash is stored. Each use swaps it for a new one (rotation).
// rotatedAt: replaced by a newer token (a second tab may still send it for a
// few seconds). revokedAt: ended on purpose (log out, password reset, theft).
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  rotatedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([cartId, variantId])
}

// PENDING -> PAID -> PACKED -> SHIPPED -> DELIVERED, or PENDING -> CANCELLED.
// Only the payment code moves an order to PAID; the admin moves it on from there.
enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  DELIVERED
  // The customer asked; the admin approves (-> CANCELLED / RETURNED) or
  // declines (-> back to where the order was).
  CANCELLATION_REQUESTED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

model Order {
  id           String      @id @default(cuid())
  // What the customer sees and reads out on the phone: "order #1004".
  number       Int         @unique @default(autoincrement())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  status       OrderStatus @default(PENDING)
  // Rupees. totalAmount = subtotal + shippingCost, and is what Razorpay charges.
  subtotal     Int
  shippingCost Int         @default(0)
  totalAmount  Int

  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String

  // Filled in by the admin when the parcel is handed to the courier.
  courierName    String?
  trackingNumber String?
  trackingUrl    String?

  reservedUntil DateTime
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  shippedAt     DateTime?
  deliveredAt   DateTime?

  // Cancellations and returns. Each can be requested once per order.
  statusBeforeRequest OrderStatus?
  cancelRequestedAt   DateTime?
  returnRequestedAt   DateTime?
  requestReason       String?
  requestDeclineNote  String?
  cancelledAt         DateTime?
  returnedAt          DateTime?

  // Filled in by the admin after refunding in the Razorpay dashboard.
  refundedAt      DateTime?
  refundAmount    Int?
  refundReference String?
  items           OrderItem[]
  payment         Payment?
  emails          OrderEmail[]
}

enum OrderEmailKind {
  ORDER_CONFIRMED
  ORDER_SHIPPED
  // To the shop's inbox, so the owner acts on a request.
  CANCELLATION_REQUESTED
  RETURN_REQUESTED
  // To the customer.
  ORDER_CANCELLED
  CANCELLATION_DECLINED
  RETURN_DECLINED
  REFUND_ISSUED
}

// An outbox: a row is written in the same transaction that changes the order,
// then sent afterwards. If sending fails, the row stays and is retried, so an
// order can never reach PAID or SHIPPED without its email being owed.
model OrderEmail {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  kind          OrderEmailKind
  attempts      Int            @default(0) // failed sends so far
  nextAttemptAt DateTime       @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())

  @@unique([orderId, kind])
  @@index([sentAt, nextAttemptAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Int
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  status            PaymentStatus @default(CREATED)
  amount            Int
  rawWebhookPayload Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}
